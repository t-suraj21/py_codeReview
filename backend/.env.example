# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_actual_gemini_api_key

# Server Port
PORT=8000

# MongoDB Connection String (Beanie ODM)
MONGODB_URL=mongodb://localhost:27017/codereview

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Sandbox Code Execution Timeout (in seconds)
EXECUTION_TIMEOUT=3.0
